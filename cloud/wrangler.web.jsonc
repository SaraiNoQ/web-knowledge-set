{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "5241ddb10b7a40275e9e3cf7a4ce3689",
  "name": "zhiye-web",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "zhiye.sarainoq.cn",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhiye-cloud",
      "database_id": "b3ac6ecc-dcf1-4bc7-a269-35c889b2ebe6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "zhiye-cloud-backups"
    },
    {
      "binding": "IMAGES",
      "bucket_name": "zhiye-cloud-images"
    }
  ],
  "browser": { "binding": "BROWSER" },
  "queues": {
    "producers": [{ "binding": "CAPTURE_QUEUE", "queue": "zhiye-cloud-capture" }],
    "consumers": [{ "queue": "zhiye-cloud-capture", "max_batch_size": 3, "max_batch_timeout": 5, "max_retries": 2 }]
  }
}
