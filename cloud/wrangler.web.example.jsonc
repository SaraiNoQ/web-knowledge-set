{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zhiye-web",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": false,
  // Deliberately empty: create a default-deny Access application first, then
  // add its custom domain only in the untracked production configuration.
  "routes": [],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhiye-cloud",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "zhiye-cloud-backups"
    },
    {
      "binding": "IMAGES",
      "bucket_name": "zhiye-cloud-images"
    }
  ],
  "browser": { "binding": "BROWSER" },
  "queues": {
    "producers": [{ "binding": "CAPTURE_QUEUE", "queue": "zhiye-cloud-capture" }],
    "consumers": [{ "queue": "zhiye-cloud-capture", "max_batch_size": 3, "max_batch_timeout": 5, "max_retries": 2 }]
  }
}
