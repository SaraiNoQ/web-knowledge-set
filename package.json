{
  "name": "zhiye",
  "version": "1.0.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "KB_DEV=1 tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/build-extension.mjs",
    "start": "node dist-server/server/index.js",
    "benchmark:knowledge-map": "tsx scripts/benchmark-knowledge-map.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.cloud.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "benchmark:library": "tsx scripts/benchmark-library.ts",
    "notices:generate": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "verify": "pnpm check && pnpm test && pnpm benchmark:library && pnpm benchmark:knowledge-map && pnpm notices:check && pnpm test:e2e",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "cloud:check": "tsx --test tests/cloud-api.test.ts",
    "cloud:bundle": "wrangler deploy --dry-run --config cloud/wrangler.web.example.jsonc && wrangler deploy --dry-run --config cloud/wrangler.clip.example.jsonc",
    "firefox:amo": "node scripts/build-extension.mjs && node scripts/validate-firefox-amo.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "d3-force-3d": "3.0.6",
    "defuddle": "^0.19.5",
    "fflate": "0.8.3",
    "ipaddr.js": "^2.5.0",
    "katex": "0.18.2",
    "linkedom": "^0.18.14",
    "mdast-util-from-markdown": "^2.1.0",
    "motion": "14.0.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "three": "0.186.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.152.0"
  }
}
