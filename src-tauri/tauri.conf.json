{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "织页",
  "version": "0.2.0",
  "identifier": "dev.local.zhiye",
  "build": {
    "beforeDevCommand": "pnpm desktop:prepare",
    "beforeBuildCommand": "pnpm desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "织页 · 本地知识库",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "把互联网文章整理为本地可编辑的 Markdown 知识库",
    "externalBin": ["binaries/node"],
    "resources": {
      "../desktop-resources/runtime/": "runtime/"
    }
  }
}
