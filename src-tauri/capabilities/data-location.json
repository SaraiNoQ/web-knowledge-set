{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "data-location",
  "description": "Allow local desktop pages to read the current data directory, choose an empty directory, and migrate it without exposing its path to Web",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": ["allow-choose-data-directory", "allow-get-data-directory", "allow-change-data-directory", "allow-cancel-staged-data-directory-change", "core:window:allow-close"]
}
