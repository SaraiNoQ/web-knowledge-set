{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "data-location",
  "description": "Allow the local onboarding page to choose an empty desktop data directory without exposing its path",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": ["allow-choose-data-directory", "core:window:allow-close"]
}
