{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-intents",
  "description": "Allow the local knowledge service page to consume validated desktop intents",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-take-external-intents",
    "allow-read-external-text",
    "allow-read-external-binary",
    "allow-discard-external-tokens"
  ]
}
