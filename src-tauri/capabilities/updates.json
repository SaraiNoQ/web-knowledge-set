{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updates",
  "description": "Allow the local desktop page to check and explicitly install signed updates",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "updater:allow-check",
    "updater:allow-download-and-install",
    "allow-updater-configured",
    "allow-restart-after-update"
  ]
}
