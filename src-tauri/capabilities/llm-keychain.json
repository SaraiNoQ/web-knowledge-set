{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "llm-keychain",
  "description": "Allow the local desktop page to manage the macOS LLM API key without reading it",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-llm-keychain-status",
    "allow-set-llm-api-key",
    "allow-delete-llm-api-key"
  ]
}
