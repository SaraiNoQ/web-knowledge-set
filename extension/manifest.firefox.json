{
  "manifest_version": 3,
  "name": "织页剪藏",
  "version": "0.1.0",
  "description": "将当前已登录网页提取为 Markdown 并保存到本地织页。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4301/*"],
  "icons": { "128": "icon.png" },
  "action": { "default_title": "织页剪藏", "default_popup": "popup.html", "default_icon": "icon.png" },
  "browser_specific_settings": { "gecko": { "id": "clipper@zhiye.local", "strict_min_version": "128.0" } }
}
